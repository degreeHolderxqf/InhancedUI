{% comment %}
  Modular Shopify OS 2.0 Section: Custom Footer
  Figma Frame: Complete Footer with Accreditation Logos & Back To Top
{% endcomment %}

<footer class="figma-industrial-theme figma-footer">
  <div class="figma-container">
    <div class="figma-footer-top">
      <!-- Col 1: Logo & Laurel Badge -->
       <div class="figma-footer-top-left">
      <div class="figma-footer-col logoBadge">
        <a href="{{ routes.root_url }}" class="figma-logo" style="margin-bottom: 16px;">
          {{ section.settings.logo_text | default: 'LOGO' }}
        </a>
        <div class="figma-footer-badge">
          <div class="figma-laurel-badge">
            <span class="num">{{ section.settings.years_num | default: '20+' }}</span>
            <span class="text">Years In Business</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Contact Us -->
      <div class="figma-footer-col contact">
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem;">
        <h4>Contact Us</h4>
          <a href="tel:{{ section.settings.phone | default: '000000000' }}" style="color: var(--color-text-muted); text-decoration: none;">
            {{ section.settings.phone | default: '000000000' }}
          </a>
          <a href="mailto:{{ section.settings.email | default: 'Abcd@gmail.com' }}" style="color: var(--color-text-muted); text-decoration: none;">
            {{ section.settings.email | default: 'Abcd@gmail.com' }}
          </a>
          
        </div>
        <div style="display: flex; gap: 16px; margin-top: 16px;">
            <a href="{{ section.settings.linkedin | default: '#' }}" style="color: var(--color-text-light); text-decoration: none; font-size: 0.85rem; font-weight: 600;">LinkedIn ↗</a>
            <a href="{{ section.settings.facebook | default: '#' }}" style="color: var(--color-text-light); text-decoration: none; font-size: 0.85rem; font-weight: 600;">Facebook ↗</a>
          </div>
      </div>
</div>
      <!-- Col 3: Quick Section -->
      <div class="figma-footer-col quicklinks">
        <h4>Quick Section</h4>
        <ul class="figma-footer-links">
          <li><a href="#services">Services</a></li>
          <li><a href="#industries">Industry</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href="#testimonials">Testimonials</a></li>
        </ul>
      </div>

      <!-- Col 4: Menu Pages -->
      <div class="figma-footer-col quicklinks">
        <h4>Menu Pages</h4>
        <ul class="figma-footer-links">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="#about">About Us</a></li>
          <li><a href="#case-studies">Case Study</a></li>
          <li><a href="#locations">Location</a></li>
          <li><a href="#blog">Blogs</a></li>
        </ul>
      </div>

      <!-- Col 5: Utility Pages -->
      <div class="figma-footer-col quicklinks">
        <h4>Utility Pages</h4>
        <ul class="figma-footer-links">
          <li><a href="#compliance">Environmental Compliance</a></li>
          <li><a href="#license">License</a></li>
          <li><a href="#gallery">Gallery</a></li>
        </ul>
      </div>
    </div>

    <!-- Partner & Accreditation Badges Strip -->
    <div class="figma-partner-strip">
      <div class="figma-partner-logo">
       <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="40" height="40" fill="#252422"/>
</svg>

      </div>
      <div class="figma-partner-logo">
      <svg width="41" height="40" viewBox="0 0 41 40" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="40.7407" height="40" fill="url(#pattern0_1_806)"/>
<rect width="40.7407" height="40" fill="white"/>
<defs>
<pattern id="pattern0_1_806" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_1_806" transform="matrix(0.000917431 0 0 0.000934421 0 -0.00365275)"/>
</pattern>
<image id="image0_1_806" width="1090" height="1078" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>

      </div>
      <div class="figma-partner-logo">
      <svg width="178" height="40" viewBox="0 0 178 40" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="177.778" height="40" fill="url(#pattern0_1_809)"/>
<rect width="177.778" height="40" fill="white"/>
<defs>
<pattern id="pattern0_1_809" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_1_809" transform="matrix(0.00101638 0 0 0.00451136 -0.00154362 0)"/>
</pattern>
<image id="image0_1_809" width="970" height="257" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>

      </div>
      <div class="figma-partner-logo">
       <svg width="71" height="40" viewBox="0 0 71 40" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="70.3704" height="40" fill="#252422"/>
</svg>

      </div>
      <div class="figma-partner-logo">
       <svg width="41" height="40" viewBox="0 0 41 40" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="40.7407" height="40" fill="#252422"/>
</svg>

      </div>
      <div class="figma-partner-logo">
       <svg width="66" height="40" viewBox="0 0 66 40" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="65.9259" height="40" fill="#252422"/>
</svg>

      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="figma-footer-bottom">
      <button class="figma-back-to-top">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
        <span>Back To Top</span>
      </button>

      <div>{{ section.settings.copyright_text | default: '2026 © Design' }}</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "LOGO"
    },
    {
      "type": "text",
      "id": "years_num",
      "label": "Years in Business",
      "default": "20+"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact Phone",
      "default": "000000000"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact Email",
      "default": "Abcd@gmail.com"
    },
    {
      "type": "url",
      "id": "linkedin",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "2026 © Design"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
