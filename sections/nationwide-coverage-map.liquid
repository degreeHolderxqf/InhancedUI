{% comment %}
  Modular Shopify OS 2.0 Section: Nationwide Coverage Map
  Figma Frame: Nationwide Coverage. Local Response.
{% endcomment %}

<section class="figma-industrial-theme figma-map-section" id="locations">
  <div class="figma-container">
    <div class="figma-map-grid">
      <div class="figma-map-left">
        <h2 class="figma-section-title">
          {{ section.settings.title_prefix | default: 'Nationwide ' }}
          <span class="highlight">{{ section.settings.title_highlight | default: 'Coverage.' }}</span><br>
          {{ section.settings.title_suffix | default: 'Local Response.' }}
        </h2>

        <div class="figma-regions-grid">
          <button class="figma-region-pill active" data-region="london">London</button>
          <button class="figma-region-pill" data-region="east-midlands">East Midlands</button>
          <button class="figma-region-pill" data-region="wales">Wales</button>
          <button class="figma-region-pill" data-region="yorkshire">Yorkshire</button>
          <button class="figma-region-pill" data-region="south-west">South West</button>
          <button class="figma-region-pill" data-region="south-east">South East</button>
          <button class="figma-region-pill" data-region="north-east">North East</button>
          <button class="figma-region-pill" data-region="north-west">North West</button>
          <button class="figma-region-pill" data-region="northern-ireland">Northern Ireland</button>
          <button class="figma-region-pill" data-region="east-england">East of England</button>
          <button class="figma-region-pill" data-region="scotland">Scotland</button>
          <button class="figma-region-pill" data-region="west-midlands">West Midlands</button>
        </div>

        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="{{ section.settings.quote_link | default: '#quote' }}" class="figma-btn figma-btn-primary">
            <span>{{ section.settings.quote_text | default: 'Get a Quote' }}</span>
         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M11.8013 6.48949L13.2869 5.00392C14.9596 3.3312 17.1495 2.63737 19.4671 2.52399C20.3686 2.47989 20.8193 2.45784 21.1807 2.81928C21.5422 3.18071 21.5201 3.63143 21.476 4.53289C21.3626 6.8505 20.6688 9.04042 18.9961 10.7131L17.5105 12.1987C16.2871 13.4221 15.9393 13.77 16.1961 15.097C16.4496 16.1107 16.6949 17.0923 15.9578 17.8294C15.0637 18.7235 14.2481 18.7235 13.354 17.8294L6.17058 10.646C5.27649 9.75188 5.27646 8.9363 6.17058 8.04219C6.90767 7.30509 7.88929 7.55044 8.90297 7.80389C10.23 8.06073 10.5779 7.71289 11.8013 6.48949Z" stroke="url(#paint0_linear_1_108)" stroke-width="1.5" stroke-linejoin="round"/>
<path d="M16.9958 7H17.0049" stroke="url(#paint1_linear_1_108)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M2.5 21.5L7.5 16.5" stroke="url(#paint2_linear_1_108)" stroke-width="1.5" stroke-linecap="round"/>
<path d="M8.5 21.5L10.5 19.5" stroke="url(#paint3_linear_1_108)" stroke-width="1.5" stroke-linecap="round"/>
<path d="M2.5 15.5L4.5 13.5" stroke="url(#paint4_linear_1_108)" stroke-width="1.5" stroke-linecap="round"/>
<defs>
<linearGradient id="paint0_linear_1_108" x1="13.5" y1="2.5" x2="13.5" y2="18.5" gradientUnits="userSpaceOnUse">
<stop stop-color="white"/>
<stop offset="1" stop-color="white" stop-opacity="0.7"/>
</linearGradient>
<linearGradient id="paint1_linear_1_108" x1="17.0003" y1="7" x2="17.0003" y2="8" gradientUnits="userSpaceOnUse">
<stop stop-color="white"/>
<stop offset="1" stop-color="white" stop-opacity="0.7"/>
</linearGradient>
<linearGradient id="paint2_linear_1_108" x1="5" y1="16.5" x2="5" y2="21.5" gradientUnits="userSpaceOnUse">
<stop stop-color="white"/>
<stop offset="1" stop-color="white" stop-opacity="0.7"/>
</linearGradient>
<linearGradient id="paint3_linear_1_108" x1="9.5" y1="19.5" x2="9.5" y2="21.5" gradientUnits="userSpaceOnUse">
<stop stop-color="white"/>
<stop offset="1" stop-color="white" stop-opacity="0.7"/>
</linearGradient>
<linearGradient id="paint4_linear_1_108" x1="3.5" y1="13.5" x2="3.5" y2="15.5" gradientUnits="userSpaceOnUse">
<stop stop-color="white"/>
<stop offset="1" stop-color="white" stop-opacity="0.7"/>
</linearGradient>
</defs>
</svg>
  </a>
          <a href="{{ section.settings.call_link | default: 'tel:12345677' }}" class="figma-btn figma-btn-outline">
           <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M16 9C16 7.05 15.3208 5.39583 13.9625 4.0375C12.6042 2.67917 10.95 2 9 2V0C10.25 0 11.4208 0.2375 12.5125 0.7125C13.6042 1.1875 14.5542 1.82917 15.3625 2.6375C16.1708 3.44583 16.8125 4.39583 17.2875 5.4875C17.7625 6.57917 18 7.75 18 9H16ZM12 9C12 8.16667 11.7083 7.45833 11.125 6.875C10.5417 6.29167 9.83333 6 9 6V4C10.3833 4 11.5625 4.4875 12.5375 5.4625C13.5125 6.4375 14 7.61667 14 9H12ZM16.95 18C14.8667 18 12.8083 17.5458 10.775 16.6375C8.74167 15.7292 6.89167 14.4417 5.225 12.775C3.55833 11.1083 2.27083 9.25833 1.3625 7.225C0.454167 5.19167 0 3.13333 0 1.05C0 0.75 0.1 0.5 0.3 0.3C0.5 0.1 0.75 0 1.05 0H5.1C5.33333 0 5.54167 0.0791667 5.725 0.2375C5.90833 0.395833 6.01667 0.583333 6.05 0.8L6.7 4.3C6.73333 4.56667 6.725 4.79167 6.675 4.975C6.625 5.15833 6.53333 5.31667 6.4 5.45L3.975 7.9C4.30833 8.51667 4.70417 9.1125 5.1625 9.6875C5.62083 10.2625 6.125 10.8167 6.675 11.35C7.19167 11.8667 7.73333 12.3458 8.3 12.7875C8.86667 13.2292 9.46667 13.6333 10.1 14L12.45 11.65C12.6 11.5 12.7958 11.3875 13.0375 11.3125C13.2792 11.2375 13.5167 11.2167 13.75 11.25L17.2 11.95C17.4333 12.0167 17.625 12.1375 17.775 12.3125C17.925 12.4875 18 12.6833 18 12.9V16.95C18 17.25 17.9 17.5 17.7 17.7C17.5 17.9 17.25 18 16.95 18ZM3.025 6L4.675 4.35L4.25 2H2.025C2.10833 2.68333 2.225 3.35833 2.375 4.025C2.525 4.69167 2.74167 5.35 3.025 6ZM11.975 14.95C12.625 15.2333 13.2875 15.4583 13.9625 15.625C14.6375 15.7917 15.3167 15.9 16 15.95V13.75L13.65 13.275L11.975 14.95Z" fill="#FFFCF2"/>
</svg>
 <span>{{ section.settings.call_text | default: 'CALL NOW' }}</span>
          </a>
        </div>
      </div>

      <div class="figma-map-right">
        <div class="figma-map-graphic-wrapper">
          <img src="{{ 'map-coverage-outline.svg' | asset_url }}" alt="UK Coverage Map">

          <!-- Interactive Pins mapped to regions -->
          <div class="figma-map-pin" style="top: 72%; left: 74%;" data-region="london" title="London Hub"></div>
          <div class="figma-map-pin" style="top: 55%; left: 62%;" data-region="east-midlands" title="East Midlands Hub"></div>
          <div class="figma-map-pin" style="top: 60%; left: 40%;" data-region="wales" title="Wales Hub"></div>
          <div class="figma-map-pin" style="top: 42%; left: 60%;" data-region="yorkshire" title="Yorkshire Hub"></div>
          <div class="figma-map-pin" style="top: 76%; left: 46%;" data-region="south-west" title="South West Hub"></div>
          <div class="figma-map-pin" style="top: 75%; left: 78%;" data-region="south-east" title="South East Hub"></div>
          <div class="figma-map-pin" style="top: 32%; left: 58%;" data-region="north-east" title="North East Hub"></div>
          <div class="figma-map-pin" style="top: 40%; left: 48%;" data-region="north-west" title="North West Hub"></div>
          <div class="figma-map-pin" style="top: 35%; left: 24%;" data-region="northern-ireland" title="Northern Ireland Hub"></div>
          <div class="figma-map-pin" style="top: 62%; left: 78%;" data-region="east-england" title="East of England Hub"></div>
          <div class="figma-map-pin" style="top: 18%; left: 48%;" data-region="scotland" title="Scotland Hub"></div>
          <div class="figma-map-pin" style="top: 58%; left: 52%;" data-region="west-midlands" title="West Midlands Hub"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nationwide Coverage Map",
  "settings": [
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title Prefix",
      "default": "Nationwide "
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight (Orange)",
      "default": "Coverage."
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Title Suffix",
      "default": "Local Response."
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote Button Text",
      "default": "Get a Quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Quote Button Link"
    },
    {
      "type": "text",
      "id": "call_text",
      "label": "Call Button Text",
      "default": "CALL NOW"
    },
    {
      "type": "url",
      "id": "call_link",
      "label": "Call Button Link"
    }
  ],
  "presets": [
    {
      "name": "Nationwide Coverage Map"
    }
  ]
}
{% endschema %}
