{% comment %}
  Modular Shopify OS 2.0 Section: Why Cleaning Matters
  Interactive Before/After Image Comparison Slider + Staggered Grid Feature Cards
{% endcomment %}

<section class="figma-industrial-theme figma-why-section" id="why-cleaning">
  <div class="figma-container">
    <div class="figma-why-layout">
      <div class="figma-why-left">
        <h2 class="figma-section-title">
          
          <span class="highlight">{{ section.settings.title_prefix | default: 'Why'   }} </span>
          {{ section.settings.middle-text }}<br>
           {{ section.settings.title_suffix | default: 'Matters' }}
        </h2>

        <div class="figma-comparison-wrapper">
          <div class="figma-comparison-slider">
            {%- if section.settings.after_image != blank -%}
              {{ section.settings.after_image | image_url: width: 800 | image_tag: class: 'figma-comparison-img', alt: 'Cleaned Vehicle Fleet' }}
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1000&q=80" class="figma-comparison-img" alt="Cleaned Vehicle Fleet">
            {%- endif -%}

            <div class="figma-comparison-overlay">
              {%- if section.settings.before_image != blank -%}
                {{ section.settings.before_image | image_url: width: 800 | image_tag: class: 'figma-comparison-img-before', alt: 'Dirty Uncleaned Vehicle' }}
              {%- else -%}
                <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?auto=format&fit=crop&w=1000&q=80" class="figma-comparison-img-before" alt="Dirty Uncleaned Vehicle">
              {%- endif -%}
            </div>

            <div class="figma-slider-handle">
            <svg width="38" height="37" viewBox="0 0 38 37" fill="none" xmlns="http://www.w3.org/2000/svg">
<foreignObject x="-10.8" y="-10.8" width="59.1" height="58.1"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(5.4px);clip-path:url(#bgblur_0_1_206_clip_path);height:100%;width:100%"></div></foreignObject><g data-figma-bg-blur-radius="10.8">
<rect x="1" y="1" width="35.5" height="34.5" rx="17.25" fill="white" fill-opacity="0.3"/>
<rect x="1" y="1" width="35.5" height="34.5" rx="17.25" stroke="#F7F6F2" stroke-width="2"/>
<path d="M23.5501 21.75L26.75 18.25L23.5501 14.75M26.75 18.25L10.75 18.2502M13.9499 21.75L10.75 18.2502L13.9499 14.75" stroke="#FFFCF2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
<defs>
<clipPath id="bgblur_0_1_206_clip_path" transform="translate(10.8 10.8)"><rect x="1" y="1" width="35.5" height="34.5" rx="17.25"/>
</clipPath></defs>
</svg>
 </div>

            <span class="figma-comparison-badge left">BEFORE</span>
            <span class="figma-comparison-badge right">AFTER</span>
          </div>
        </div>
      </div>

      <div class="figma-why-right">
        <div class="figma-why-cards-grid">
          {%- for block in section.blocks -%}
            <div class="figma-why-card card-{{ block.settings.theme }}" {{ block.shopify_attributes }}>
              <div class="figma-card-icon">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- when 'search' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  {%- when 'excavator' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
                  {%- when 'wrench' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                  {%- when 'recycle' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 19 3 15 7 11"/><path d="M3 15h11a5 5 0 0 0 5-5 5 5 0 0 0-5-5H3"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                {%- endcase -%}
              </div>
              <h3 class="figma-card-title">{{ block.settings.title }}</h3>
              <p class="figma-card-desc">{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Cleaning Matters",
  "settings": [
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title Prefix",
      "default": "Why "
    },
    {
      "type": "text",
      "id": "middle-text",
      "label": "Title Highlight (Orange)",
      "default": "Cleaning"
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Title Suffix",
      "default": "Matters"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image (Dirty)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image (Clean)"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "theme",
          "label": "Card Theme",
          "options": [
            { "value": "light", "label": "White Light Theme" },
            { "value": "dark", "label": "Dark Theme" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (Asset Protection)" },
            { "value": "search", "label": "Search (Inspections)" },
            { "value": "excavator", "label": "Excavator (Performance)" },
            { "value": "wrench", "label": "Wrench (Maintenance)" },
            { "value": "recycle", "label": "Recycle (Compliance)" },
            { "value": "truck", "label": "Truck (Fleet Image)" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Asset Protection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Removes corrosive contaminants, waste residue and heavy build-up that accelerate wear, corrosion and component failure."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Cleaning Matters",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "theme": "light",
            "icon": "shield",
            "title": "Asset Protection",
            "description": "Removes corrosive contaminants, waste residue and heavy build-up that accelerate wear, corrosion and component failure."
          }
        },
        {
          "type": "card",
          "settings": {
            "theme": "dark",
            "icon": "search",
            "title": "Easier Inspections",
            "description": "A clean fleet makes it easier to identify leaks, damage, and maintenance issues before they become costly repairs."
          }
        },
        {
          "type": "card",
          "settings": {
            "theme": "light",
            "icon": "excavator",
            "title": "Improved Performance",
            "description": "Clean vehicles and equipment operate more efficiently by preventing excessive build-up of dirt, grease, and debris."
          }
        },
        {
          "type": "card",
          "settings": {
            "theme": "dark",
            "icon": "wrench",
            "title": "Lower Maintenance Costs",
            "description": "Preventative maintenance reduces expensive repairs, extends asset life and minimises long-term operating costs."
          }
        },
        {
          "type": "card",
          "settings": {
            "theme": "light",
            "icon": "recycle",
            "title": "Compliance Ready",
            "description": "Supports environmental legislation, health & safety standards and waste industry regulations across every operation."
          }
        },
        {
          "type": "card",
          "settings": {
            "theme": "dark",
            "icon": "truck",
            "title": "Professional Fleet Image",
            "description": "Well-maintained vehicles demonstrate professionalism, reliability, and operational excellence to stakeholders."
          }
        }
      ]
    }
  ]
}
{% endschema %}
