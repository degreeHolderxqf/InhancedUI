{% comment %}
  Modular Shopify OS 2.0 Section: Industries Grid
  Figma Frame: Industries Built Around Operational Demands
{% endcomment %}

<section class="figma-industrial-theme figma-industries-section" id="industries">
  <div class="figma-container">
  <div class="figma-container-head">
    <h2 class="figma-section-title">
      {{ section.settings.title_prefix | default: 'Industries Built Around ' }}<br>
      <span class="highlight">{{ section.settings.title_highlight | default: 'Operational Demands' }}</span>
    </h2>
    <p class="figma-section-subtitle">
      {{ section.settings.subtitle | default: 'Supporting organisations operating in waste management, municipal services, construction, quarrying and environmental sectors across the UK.' }}
    </p>
</div>
    <div class="figma-industries-grid">
      <!-- Featured Industry Card -->
      <div class="figma-industry-featured">
        {%- if section.settings.featured_image != blank -%}
          {{ section.settings.featured_image | image_url: width: 600 | image_tag: class: 'figma-industry-featured-img', alt: 'Waste Management Fleet' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1590674899484-d5640e854abe?auto=format&fit=crop&w=800&q=80" class="figma-industry-featured-img" alt="Waste Management Fleet">
        {%- endif -%}

        <div class="figma-industry-featured-body">
          <div>
            <h3 class="figma-section-title" style="font-size: 1.6rem; margin-bottom: 12px;">
              {{ section.settings.featured_title | default: 'Waste Management' }}
            </h3>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
              {{ section.settings.featured_desc | default: 'Supporting waste operators, transfer stations and refuse collection fleets with specialist RCV maintenance, dig-outs, hopper services and environmental compliance solutions.' }}
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary Industry Cards Grid -->
      <div class="figma-industry-cards-wrap">
        {%- for block in section.blocks -%}
          <div class="figma-industry-card bg-dot-pattern" {{ block.shopify_attributes }}>
            <div class="figma-card-icon" style="margin-bottom: 16px;">
              {%- case block.settings.icon -%}
                {%- when 'recycle' -%}
               <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
