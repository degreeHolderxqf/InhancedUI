{% comment %}
  Modular Shopify OS 2.0 Section: Industries Grid
  Figma Frame: Industries Built Around Operational Demands
{% endcomment %}

<section class="figma-industrial-theme figma-industries-section" id="industries">
  <div class="figma-container">
  <div class="figma-container-head">
    <h2 class="figma-section-title">
      {{ section.settings.title_prefix | default: 'Industries Built Around ' }}<br>
      <span class="highlight">{{ section.settings.title_highlight | default: 'Operational Demands' }}</span>
    </h2>
    <p class="figma-section-subtitle">
      {{ section.settings.subtitle | default: 'Supporting organisations operating in waste management, municipal services, construction, quarrying and environmental sectors across the UK.' }}
    </p>
</div>
    <div class="figma-industries-grid">
      <!-- Featured Industry Card -->
      <div class="figma-industry-featured">
        {%- if section.settings.featured_image != blank -%}
          {{ section.settings.featured_image | image_url: width: 600 | image_tag: class: 'figma-industry-featured-img', alt: 'Waste Management Fleet' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1590674899484-d5640e854abe?auto=format&fit=crop&w=800&q=80" class="figma-industry-featured-img" alt="Waste Management Fleet">
        {%- endif -%}

        <div class="figma-industry-featured-body">
          <div>
            <h3 class="figma-section-title" style="font-size: 1.6rem; margin-bottom: 12px;">
              {{ section.settings.featured_title | default: 'Waste Management' }}
            </h3>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">
              {{ section.settings.featured_desc | default: 'Supporting waste operators, transfer stations and refuse collection fleets with specialist RCV maintenance, dig-outs, hopper services and environmental compliance solutions.' }}
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary Industry Cards Grid -->
      <div class="figma-industry-cards-wrap">
        {%- for block in section.blocks -%}
          <div class="figma-industry-card bg-dot-pattern" {{ block.shopify_attributes }}>
            <div class="figma-card-icon" style="margin-bottom: 16px;">
              {%- case block.settings.icon -%}
                {%- when 'recycle' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 19 3 15 7 11"/><path d="M3 15h11a5 5 0 0 0 5-5 5 5 0 0 0-5-5H3"/></svg>
                {%- when 'construction' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                {%- when 'plant' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'building' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/></svg>
                {%- when 'utilities' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 7 0 6-4.5 9-10 11z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
            </div>
            <h4 class="figma-card-title" style="margin-bottom: 8px;">{{ block.settings.title }}</h4>
            <p class="figma-card-desc">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Industries Grid",
  "settings": [
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title Prefix",
      "default": "Industries Built Around "
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight (Orange)",
      "default": "Operational Demands"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Paragraph",
      "default": "Supporting organisations operating in waste management, municipal services, construction, quarrying and environmental sectors across the UK."
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Card Image"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Card Title",
      "default": "Waste Management"
    },
    {
      "type": "textarea",
      "id": "featured_desc",
      "label": "Featured Card Description",
      "default": "Supporting waste operators, transfer stations and refuse collection fleets with specialist RCV maintenance, dig-outs, hopper services and environmental compliance solutions."
    }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "recycle", "label": "Recycle" },
            { "value": "construction", "label": "Construction" },
            { "value": "plant", "label": "Plant Hire" },
            { "value": "truck", "label": "Logistics & Transport" },
            { "value": "building", "label": "Local Authorities" },
            { "value": "utilities", "label": "Utilities Sector" },
            { "value": "leaf", "label": "Environmental Services" }
          ],
          "default": "recycle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Industry Title",
          "default": "Recycling Industry"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Industry Description",
          "default": "Helping recycling operators maintain site standards across demanding operational environments."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industries Grid",
      "blocks": [
        {
          "type": "industry",
          "settings": {
            "icon": "recycle",
            "title": "Recycling Industry",
            "description": "Helping recycling operators maintain site standards across demanding operational environments."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "construction",
            "title": "Construction Industry",
            "description": "Providing specialist support for contractors operating excavators, telehandlers, loading shovels and heavy construction equipment."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "plant",
            "title": "Plant Hire Companies",
            "description": "Preparing hired equipment for customer handover while maintaining compliance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "truck",
            "title": "Logistics & Transport",
            "description": "Supporting transport operators and logistics businesses with fleet maintenance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "building",
            "title": "Local Authorities & Councils",
            "description": "Supporting municipal fleets, public service vehicles, and street cleansing departments nationwide."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "utilities",
            "title": "Utilities Sector",
            "description": "Supporting utility providers and infrastructure contractors with specialist fleet maintenance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "leaf",
            "title": "Environmental Services",
            "description": "Helping environmental contractors maintain fleet readiness while meeting strict obligations."
          }
        }
      ]
    }
  ]
}
{% endschema %}
