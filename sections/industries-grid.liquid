{% schema %}
{
  "name": "Industries Grid",
  "settings": [
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title Prefix",
      "default": "Industries Built Around "
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight (Orange)",
      "default": "Operational Demands"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Paragraph",
      "default": "Supporting organisations operating in waste management, municipal services, construction, quarrying and environmental sectors across the UK."
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Card Image"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Card Title",
      "default": "Waste Management"
    },
    {
      "type": "textarea",
      "id": "featured_desc",
      "label": "Featured Card Description",
      "default": "Supporting waste operators, transfer stations and refuse collection fleets with specialist RCV maintenance, dig-outs, hopper services and environmental compliance solutions."
    }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "recycle", "label": "Recycle" },
            { "value": "construction", "label": "Construction" },
            { "value": "plant", "label": "Plant Hire" },
            { "value": "truck", "label": "Logistics & Transport" },
            { "value": "building", "label": "Local Authorities" },
            { "value": "utilities", "label": "Utilities Sector" },
            { "value": "leaf", "label": "Environmental Services" }
          ],
          "default": "recycle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Industry Title",
          "default": "Recycling Industry"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Industry Description",
          "default": "Helping recycling operators maintain site standards across demanding operational environments."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industries Grid",
      "blocks": [
        {
          "type": "industry",
          "settings": {
            "icon": "recycle",
            "title": "Recycling Industry",
            "description": "Helping recycling operators maintain site standards across demanding operational environments."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "construction",
            "title": "Construction Industry",
            "description": "Providing specialist support for contractors operating excavators, telehandlers, loading shovels and heavy construction equipment."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "plant",
            "title": "Plant Hire Companies",
            "description": "Preparing hired equipment for customer handover while maintaining compliance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "truck",
            "title": "Logistics & Transport",
            "description": "Supporting transport operators and logistics businesses with fleet maintenance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "building",
            "title": "Local Authorities & Councils",
            "description": "Supporting municipal fleets, public service vehicles, and street cleansing departments nationwide."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "utilities",
            "title": "Utilities Sector",
            "description": "Supporting utility providers and infrastructure contractors with specialist fleet maintenance."
          }
        },
        {
          "type": "industry",
          "settings": {
            "icon": "leaf",
            "title": "Environmental Services",
            "description": "Helping environmental contractors maintain fleet readiness while meeting strict obligations."
          }
        }
      ]
    }
  ]
}
{% endschema %}
