{% comment %}
  Modular Shopify OS 2.0 Section: Custom Header & Top Bar
  Matching Figma Industrial Theme Handoff
{% endcomment %}

<header class="figma-industrial-theme">
  {%- if section.settings.show_top_bar -%}
    <div class="figma-top-bar">
      <div class="figma-container figma-top-bar-inner">
        <div class="figma-top-bar-left">
          {%- if section.settings.item_1_text != blank -%}
            <div class="figma-top-bar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{ section.settings.item_1_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.item_2_text != blank -%}
            <div class="figma-top-bar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{{ section.settings.item_2_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.item_3_text != blank -%}
            <div class="figma-top-bar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span>{{ section.settings.item_3_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.item_4_text != blank -%}
            <div class="figma-top-bar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{{ section.settings.item_4_text }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="figma-top-bar-right">
          {%- if section.settings.phone_number != blank -%}
            <a href="tel:{{ section.settings.phone_number }}" class="figma-top-phone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{{ section.settings.phone_number }}</span>
            </a>
          {%- endif -%}

          <div class="figma-social-links">
            <a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="figma-header-main">
    <div class="figma-container figma-header-inner">
      <a href="{{ routes.root_url }}" class="figma-logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'eager', alt: shop.name }}
        {%- else -%}
          {{ section.settings.logo_text | default: 'LOGO' }}
        {%- endif -%}
      </a>

      <nav class="figma-nav">
        <ul class="figma-nav-list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li>
              <a href="{{ link.url }}" class="figma-nav-link{% if link.active %} active{% endif %}">
                {{ link.title }}
                {%- if link.links != blank -%}
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                {%- endif -%}
              </a>
            </li>
          {%- else -%}
            <li><a href="#about" class="figma-nav-link">ABOUT US</a></li>
            <li><a href="#services" class="figma-nav-link">SERVICES <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></a></li>
            <li><a href="#industries" class="figma-nav-link">INDUSTRIES</a></li>
            <li><a href="#locations" class="figma-nav-link">LOCATIONS</a></li>
            <li><a href="#case-studies" class="figma-nav-link">CASE STUDIES</a></li>
            <li><a href="#gallery" class="figma-nav-link">GALLERY</a></li>
            <li><a href="#blog" class="figma-nav-link">BLOG</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="figma-header-actions">
        <a href="{{ section.settings.btn_link | default: '#quote' }}" class="figma-btn figma-btn-primary">
          <span>{{ section.settings.btn_text | default: 'Get a Quote' }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Custom Header & Top Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "Show Top Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "item_1_text",
      "label": "Top Bar Item 1",
      "default": "24/7 RESPONSE CAPABILITY"
    },
    {
      "type": "text",
      "id": "item_2_text",
      "label": "Top Bar Item 2",
      "default": "NATIONWIDE COVERAGE"
    },
    {
      "type": "text",
      "id": "item_3_text",
      "label": "Top Bar Item 3",
      "default": "Rapid Response Times"
    },
    {
      "type": "text",
      "id": "item_4_text",
      "label": "Top Bar Item 4",
      "default": "7 days a Week"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "12345677"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn Link"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook Link"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text Fallback",
      "default": "LOGO"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "CTA Button Text",
      "default": "Get a Quote"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Header & Top Bar"
    }
  ]
}
{% endschema %}
